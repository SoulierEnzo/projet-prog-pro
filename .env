# Liste des modèles à précharger (séparés par des virgules)
# Quelques idées de modèles (à adapter) :
#   - llama3.1:8b             (génération généraliste)
#   - qwen2.5:7b              (généraliste multilingue)
#   - qwen2.5-coder:7b        (code)
#   - mistral:7b-instruct     (léger, francophone correct)
#   - granite3-dense:8b       (IBM Granite, si dispo)
#   - nomic-embed-text:latest (embeddings)
OLLAMA_MODELS=llama3.1:8b,mistral:7b-instruct

OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
